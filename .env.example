# ==============================================================
# AFRA TECH POINT - ENVIRONMENT VARIABLES (VERCEL PRODUCTION)
# ==============================================================

# ── 1. SHOP & ADMIN CONFIGURATION ─────────────────────────────
# CRITICAL: set this to your REAL public domain (no trailing slash).
# This is used for password-reset links, email verification links,
# sitemap/robots and SEO metadata. NEVER use localhost here in production.
NEXT_PUBLIC_SHOP_URL=https://afratechpoint.shop
# Optional server-only override (takes precedence, no rebuild needed on Vercel)
SITE_URL=https://afratechpoint.shop
NEXT_PUBLIC_BASE_URL=https://afratechpoint.shop
NEXT_PUBLIC_USE_FIREBASE=true
NEXT_PUBLIC_ADMIN_EMAILS=afratechpoint@gmail.com
ADMIN_EMAIL=afratechpoint@gmail.com

# ── 2. FIREBASE CLIENT (PUBLIC) ───────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── 3. FIREBASE ADMIN SDK (SERVER PRIVATE) ────────────────────
# Note for Vercel: Paste the private key including BEGIN and END tags, or with escaped \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# ── 4. EMAIL (SMTP - GMAIL APP PASSWORD) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Afra Tech Point <afratechpoint@gmail.com>"

# ── 5. IMAGE UPLOAD (IMAGEKIT / IMGBB SERVER PRIVATE) ─────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_ENDPOINT=https://ik.imagekit.io/afratechpoint
IMGBB_API_KEY=

# ── 6. STEADFAST COURIER & WEBHOOK (SERVER PRIVATE) ───────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=

# ── 7. SECURITY & CRYPTOGRAPHY (SERVER PRIVATE) ───────────────
OTP_ENCRYPTION_SECRET=

